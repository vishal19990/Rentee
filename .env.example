# MongoDB connection string. With the default local URI, `npm run dev` / `npm run seed`
# start a persistent local mongod (mongodb-memory-server, data in .data/db) if nothing
# is already listening on 127.0.0.1:27017.
MONGODB_URI=mongodb://127.0.0.1:27017/rentee

# Secret used to sign session JWTs. REQUIRED in production (use 32+ random chars).
AUTH_SECRET=change-me-to-a-long-random-string

# App-wide currency (ISO 4217) and number-format locale.
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN

# Admin account created by `npm run seed` (add --admin-only to skip demo data).
# Against a non-local MONGODB_URI (e.g. Atlas) ADMIN_PASSWORD is required.
ADMIN_EMAIL=admin@rentee.local
ADMIN_PASSWORD=rentee123
ADMIN_NAME=Admin

# Optional: build output folder (default .next).
# NEXT_DIST_DIR=.next-verify

# WhatsApp reminders: country code added to 10-digit phone numbers with no +/00 prefix.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
